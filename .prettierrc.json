{
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,                 
    "semi": true, 
    "singleQuote": true, 
    "quoteProps": "as-needed", 
    "jsxSingleQuote": true, 
    "trailingComma": "none", 
    "bracketSpacing": true,
    "bracketSameLine": false,     
    "arrowParens": "always", 
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "ignore", 
    "vueIndentScriptAndStyle": false, 
    "embeddedLanguageFormatting": "auto", 
    "proseWrap": "always", 
    "overrides": [
      {
        "files": "*.vue",
        "options": {
          "parser": "vue"
        }
      },
      {
        "files": "*.scss",
        "options": {
          "parser": "scss"
        }
      },
      {
        "files": "*.json",
        "options": {
          "parser": "json"
        }
      }
    ]
  }
  